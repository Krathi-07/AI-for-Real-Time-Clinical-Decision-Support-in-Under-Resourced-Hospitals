# Python caches — regenerated automatically inside the container
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Virtual environment — the container builds its own venv from scratch
.venv/
venv/
env/

# uv cache
.uv/

# Data — never goes into a container image (too large, contains PHI)
data/
*.csv
*.parquet
*.h5
*.pkl

# Trained model files — mounted at runtime, not baked into image
models/

# Notebooks — not needed for the API server
notebooks/
.ipynb_checkpoints/

# Tests — not needed in production image
tests/

# Docs
docs/

# Git history
.git/
.gitignore

# IDE files
.vscode/
.idea/

# Environment files — secrets must NEVER go into an image
.env
.env.*

# OS files
.DS_Store
Thumbs.db

# This file itself
.dockerignore

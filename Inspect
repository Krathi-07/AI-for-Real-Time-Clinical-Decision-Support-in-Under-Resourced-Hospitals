from pathlib import Path

text = Path("src/api/main.py").read_text(encoding="utf-8")
lines = text.splitlines()

targets = {
    "themeBtn": [],
    "filterPatients": [],
    "refreshStats": [],
    "sc-total-val": [],
    "toggleTheme": [],
    "Dark": [],
}

for i, line in enumerate(lines, 1):
    for key in targets:
        if key in line:
            targets[key].append((i, line.rstrip()))

for key, hits in targets.items():
    print(f"\n── {key} ({'FOUND' if hits else 'MISSING'}) ──")
    for lineno, content in hits:
        print(f"  {lineno:4d}  {content[:100]}")
        